.services-section { padding-top: 105px; padding-bottom: 105px; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 35px; margin-bottom: 35px; }
.section-heading h2, .about-main h2, .contact-content h2 { margin-top: 17px; font-size: clamp(32px, 4vw, 46px); letter-spacing: -1.8px; }
.section-heading > p { max-width: 350px; margin: 0 0 4px; color: var(--muted); font-size: 12px; line-height: 1.9; }
.services-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
.service-card { position: relative; min-height: 250px; padding: 25px 24px 27px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: linear-gradient(140deg, #0c110e, #0a0e0b); transition: background .25s, transform .25s; }
.service-card:hover { background: linear-gradient(140deg, #111c14, #0c130e); }
.service-card-top { display: flex; align-items: center; justify-content: space-between; }
.service-icon { display: grid; place-items: center; width: 43px; height: 43px; border: 1px solid #7be49532; border-radius: 10px; background: #132119; color: var(--green); }
.service-number { color: #566259; font-size: 10px; font-weight: 700; }
.service-card h3 { margin: 22px 0 9px; font-family: Manrope, sans-serif; font-size: 16px; letter-spacing: -.4px; }
.service-card > p { max-width: 310px; margin: 0; color: #929e95; font-size: 11px; line-height: 1.8; }
.service-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; padding-right: 20px; }
.service-tags span { padding: 5px 7px; border: 1px solid #cce5d018; border-radius: 4px; color: #8f9d92; font-size: 8px; }
.service-link { position: absolute; right: 22px; bottom: 22px; display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid var(--line); border-radius: 7px; color: #8da393; transition: color .2s, background .2s; }
.service-link:hover { background: var(--green); color: #08110a; }
.text-link { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 7px; margin-top: 29px; color: #8c9a8f; font-size: 11px; }
.text-link > span { display: inline-flex; align-items: center; gap: 4px; color: var(--green); font-weight: 700; }
.about-section { border-block: 1px solid var(--line); background: radial-gradient(ellipse at 4% 50%, #14251a 0%, #0a0e0b 50%, #080b09 80%); }
.about-layout { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 70px; padding-block: 90px; }
.about-main h2 { font-size: clamp(36px, 4vw, 49px); line-height: 1.2; }
.about-description { max-width: 460px; margin: 20px 0 25px; color: var(--muted); font-size: 13px; line-height: 1.95; }
.strength-list { display: flex; flex-direction: column; }
.strength-item { display: grid; grid-template-columns: 44px 1fr 20px; align-items: center; gap: 15px; padding: 22px 0; border-bottom: 1px solid var(--line); }
.strength-item:first-child { border-top: 1px solid var(--line); }
.strength-icon { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid #7be4952b; border-radius: 9px; background: #132018; color: var(--green); }
.strength-item h3 { margin: 0 0 6px; font-size: 13px; font-weight: 700; }
.strength-item p { margin: 0; color: #8e9b91; font-size: 10px; line-height: 1.7; }
.strength-check { color: #64d781; opacity: .75; }
.contact-section { padding-top: 100px; padding-bottom: 85px; }
.contact-panel { position: relative; display: grid; grid-template-columns: 1.1fr .9fr; gap: 45px; overflow: hidden; padding: 48px; border: 1px solid #7be49528; border-radius: 15px; background: linear-gradient(125deg, #101b13, #0c120e 60%, #101b13); }
.contact-glow { position: absolute; top: -140px; left: -100px; width: 360px; height: 300px; border-radius: 50%; background: #3dba6420; filter: blur(70px); pointer-events: none; }
.contact-content, .contact-details { position: relative; z-index: 1; }
.contact-content h2 { max-width: 510px; font-size: clamp(33px, 4vw, 47px); }
.contact-content > p { max-width: 420px; margin: 18px 0 22px; color: #9ca89f; font-size: 12px; line-height: 1.9; }
.contact-actions { display: flex; flex-wrap: wrap; gap: 10px; }
.contact-actions .button-primary, .contact-actions .button-secondary { min-height: 44px; font-size: 11px; }
.contact-details { display: flex; flex-direction: column; justify-content: center; gap: 11px; }
.contact-details > a { display: grid; grid-template-columns: 42px 1fr 18px; align-items: center; gap: 12px; padding: 17px 15px; border: 1px solid var(--line); border-radius: 9px; background: #0a100c99; transition: border-color .2s, background .2s; }
.contact-details > a:hover { border-color: #7be49562; background: #132018; }
.contact-detail-icon { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid #7be49532; border-radius: 9px; background: #14241a; color: var(--green); }
.contact-detail-icon.whatsapp { color: #7be495; }
.contact-details > a > span:nth-child(2) { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
.contact-details small { color: #7f8f83; font-size: 8px; font-weight: 700; letter-spacing: 1.2px; }
.contact-details b { overflow-wrap: anywhere; color: #e5eee7; font-size: 11px; font-weight: 600; }
.contact-details > a > svg { color: #7f8f83; }
.footer { padding-top: 27px; padding-bottom: 22px; border-top: 1px solid var(--line); }
.footer-brand .brand-mark { width: 31px; height: 31px; font-size: 11px; }
.footer-brand { font-size: 16px; }
.footer > p { margin: 13px 0 19px; color: #849187; font-size: 10px; }
.footer-links { display: flex; gap: 20px; padding-bottom: 23px; border-bottom: 1px solid var(--line); }
.footer-links a { display: inline-flex; align-items: center; gap: 4px; color: #a1ada3; font-size: 10px; }
.footer-links a:hover { color: var(--green); }
.footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding-top: 18px; color: #657168; font-size: 9px; }
.footer-bottom > span:last-child { display: inline-flex; align-items: center; gap: 8px; }
.footer-bottom i { display: inline-block; width: 3px; height: 3px; }
@media (max-width: 900px) {
  .section-heading { align-items: start; flex-direction: column; gap: 12px; }
  .section-heading > p { max-width: 510px; }
  .services-grid { grid-template-columns: repeat(2, 1fr); }
  .about-layout { gap: 35px; }
  .contact-panel { padding: 32px; gap: 24px; }
}
@media (max-width: 600px) {
  .services-section { padding-top: 72px; padding-bottom: 72px; }
  .section-heading h2, .about-main h2 { font-size: 34px; letter-spacing: -1.3px; }
  .services-grid { grid-template-columns: 1fr; }
  .service-card { min-height: 225px; padding: 21px; }
  .about-layout { grid-template-columns: 1fr; gap: 30px; padding-block: 65px; }
  .strength-item { gap: 11px; grid-template-columns: 40px 1fr 18px; }
  .strength-icon { width: 38px; height: 38px; }
  .contact-section { padding-top: 65px; padding-bottom: 55px; }
  .contact-panel { grid-template-columns: 1fr; padding: 25px 18px; gap: 27px; }
  .contact-content h2 { font-size: 36px; letter-spacing: -1.5px; }
  .contact-actions .button-primary, .contact-actions .button-secondary { padding-inline: 11px; }
  .footer-bottom { align-items: start; flex-direction: column; }
}


@media (max-width: 640px) {
  .contact-glow { filter: none; }
}
